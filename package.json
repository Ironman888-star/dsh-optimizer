{
  "name": "dsh-optimizer",
  "version": "0.3.7",
  "description": "Unofficial DeepSeek Harness plugin: local cost/token insights, recent-turn context packing, editable task instructions, and integrated dsh-delete-turn v0.2.7 message/turn deletion.",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon.svg": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "lib",
    "locale",
    "icon.svg",
    "cordis.patch.yml",
    "docs",
    "README.md",
    "README.en.md",
    "RELEASE_NOTES_v0.3.6.md",
    "CHANGELOG.md",
    "LICENSE",
    "PRIVACY.md",
    "SECURITY.md",
    "vendor/dsh-delete-turn",
    "THIRD_PARTY_NOTICES.md",
    "RELEASE_NOTES_v0.3.7-beta.2.md",
    "RELEASE_NOTES_v0.3.7-beta.3.md",
    "RELEASE_NOTES_v0.3.7.md",
    "SOURCE_INTEGRITY.sha256"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test tests/*.test.js vendor/dsh-delete-turn/test/button-timing.test.js vendor/dsh-delete-turn/test/client.test.js vendor/dsh-delete-turn/test/host.test.js vendor/dsh-delete-turn/test/logic.test.js",
    "check": "node --check index.js && node --check client.js && node --check lib/host.js && node --check lib/server.js && node --check lib/context-packing.js && node --check lib/task-instructions.js && node --check vendor/dsh-delete-turn/src/index.js && node --check vendor/dsh-delete-turn/src/client.js && npm run verify:vendor",
    "release:audit": "node scripts/release-audit.mjs",
    "verify:vendor": "node scripts/verify-vendor-client.mjs"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "token",
    "cost",
    "context",
    "observability",
    "context-packing",
    "turn-deletion",
    "task-instructions",
    "deepseek",
    "dsh-optimizer"
  ],
  "license": "MIT",
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  }
}
